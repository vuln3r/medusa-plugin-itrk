{
  "name": "@sadu-dev/medusa-plugin-itrk",
  "version": "0.0.2",
  "description": "Medusa plugin for syncing IT-Recht Kanzlei legal documents and exposing them to storefronts.",
  "author": "SADU Development e.U. (https://sadu.at)",
  "license": "MIT",
  "homepage": "https://sadu.at",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuln3r/medusa-plugin-itrk.git"
  },
  "bugs": {
    "url": "https://github.com/vuln3r/medusa-plugin-itrk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./.medusa/server/src/index.js",
  "types": "./.medusa/server/src/index.d.ts",
  "files": [
    ".medusa/server",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./.medusa/server/src/index.js",
    "./package.json": "./package.json",
    "./types": "./.medusa/server/src/types.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-plugin-other",
    "medusa-plugin-integration",
    "medusa-v2",
    "itrk",
    "it-recht-kanzlei",
    "legal-documents"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.13.5",
    "@medusajs/cli": "2.13.5",
    "@medusajs/framework": "2.13.5",
    "@medusajs/icons": "2.13.5",
    "@medusajs/medusa": "2.13.5",
    "@medusajs/test-utils": "2.13.5",
    "@medusajs/ui": "4.0.25",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.12.0 <3",
    "@medusajs/cli": ">=2.12.0 <3",
    "@medusajs/framework": ">=2.12.0 <3",
    "@medusajs/icons": ">=2.12.0 <3",
    "@medusajs/medusa": ">=2.12.0 <3",
    "@medusajs/test-utils": ">=2.12.0 <3",
    "@medusajs/ui": ">=4.0.25 <5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.9",
    "xmlbuilder2": "^4.0.3"
  }
}
